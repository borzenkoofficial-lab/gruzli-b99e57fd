# Set in Amvera project variables. Never commit real credentials.
DATABASE_URL=postgresql://user:password@host:5432/gruzli
# Alternative connection settings:
# PGHOST=
# PGPORT=5432
# PGDATABASE=gruzli
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=disable

PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
DATA_DIR=/data
